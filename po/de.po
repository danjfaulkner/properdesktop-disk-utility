msgstr "Details einblenden"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Zum Prüfen von {format}-Volumes wird {tool} benötigt, das nicht installiert ist."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "„{name}“ ist nicht mehr vorhanden."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Erste Hilfe prüft jedes Volume auf der Festplatte auf Fehler und repariert die gefundenen. Eingehängte Volumes werden während der Prüfung ausgehängt und danach wieder eingehängt."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Erste Hilfe prüft jedes Volume auf der Festplatte auf Fehler und repariert die gefundenen."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Erste Hilfe prüft das Volume auf Fehler und repariert die gefundenen. Das Volume wird während der Prüfung ausgehängt, seine Dateien können also erst danach wieder verwendet werden."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Erste Hilfe prüft das Volume auf Fehler und repariert die gefundenen."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Erste Hilfe für „{name}“ ausführen?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Ausführen"


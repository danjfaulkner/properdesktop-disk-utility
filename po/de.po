msgstr "Das Dateisystem hat Fehler."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 konnte nicht feststellen, ob {format}-Volumes repariert werden können."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "{format}-Volumes können nicht repariert werden: {tool} ist nicht installiert."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."

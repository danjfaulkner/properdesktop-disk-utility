msgstr "„{name}“ wird von {programs} verwendet und kann nicht ausgehängt werden. Schließen Sie deren Dateien darauf oder beenden Sie sie, und führen Sie Erste Hilfe dann erneut aus."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "„{name}“ konnte nicht ausgehängt werden: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Das Dateisystem wird geprüft."

#: src/dialogs/firstaid.cpp
#, python-brace-format

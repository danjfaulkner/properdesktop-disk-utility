msgstr "„{name}“ wird wieder eingehängt."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "„{name}“ konnte nicht wieder eingehängt werden: {message}"

#: src/dialogs/firstaid.cpp

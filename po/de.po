#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Das Image kann nicht auf „{name}“ selbst gesichert werden. Wählen Sie einen Ordner auf einer anderen Festplatte."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "„{name}“ enthält das laufende System und kann daher zum Lesen nicht ausgehängt werden."


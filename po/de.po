#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "„{name}“ wird geprüft ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "unbekanntes Format"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 konnte nicht feststellen, ob {format}-Volumes geprüft werden können. Versuchen Sie es später erneut."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "{format}-Volumes können nicht geprüft werden: {tool} ist nicht installiert."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "„{name}“ wird ausgehängt."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "„{name}“ wird verwendet und kann nicht ausgehängt werden. Schließen Sie die Dateien und beenden Sie die Programme, die es verwenden, und führen Sie Erste Hilfe dann erneut aus."


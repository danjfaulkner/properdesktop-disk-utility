msgid "There are no volumes to check."
msgstr "Es gibt keine Volumes zum Prüfen."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "„{name}“ wird geprüft …"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "„{name}“ ist nicht mehr vorhanden. Übersprungen."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "„{name}“ ist gesperrt. Entsperren Sie es, um es zu prüfen. Übersprungen."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "„{name}“ enthält kein Dateisystem, das Erste Hilfe prüfen kann. Übersprungen."


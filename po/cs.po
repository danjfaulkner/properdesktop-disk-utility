msgid "Format"
msgstr "Formát"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Scheme"
msgstr "Schéma"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Šifrovat"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Heslo"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Povinné"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Ověřit"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Svazek lze číst až po odemčení heslem. Pokud heslo zapomenete, data nebude možné obnovit."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Možnosti zabezpečení…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Vymazat"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "vyžaduje alespoň {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "{format} nelze vybrat: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Hesla se neshodují."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Hlavní spouštěcí záznam dosáhne jen na prvních {reach} disku „{name}“; zbývajících {rest} zůstane nevyužito. Chcete-li využít celý prostor, vyberte Tabulku oddílů GUID."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Data se nejprve přepíšou nulami, což trvá stejně dlouho jako jeden zápis celého svazku."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Rychlé vymazání"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Vynulovat data"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Hotovo"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Krok {step} z {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Zastavování „{step}“…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "„{name}“ byl vymazán."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "„{name}“ byl vymazán jen zčásti a nyní nemá použitelný svazek. Chcete-li ho použít, vymažte ho znovu."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "„{name}“ nebyl vymazán; nic z toho, co je na něm uloženo, se nezměnilo."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "Krok „{step}“ byl zastaven před dokončením."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "Krok „{step}“ byl zrušen."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "Krok „{step}“ selhal."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "Krok „{step}“ selhal: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Skrýt podrobnosti"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Zobrazit podrobnosti"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Kontrola svazků {format} vyžaduje {tool}, který není nainstalován."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "„{name}“ už není k dispozici."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "První pomoc zkontroluje chyby na všech svazcích disku a opraví ty, které najde. Připojené svazky se během kontroly odpojí a potom znovu připojí."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "První pomoc zkontroluje chyby na všech svazcích disku a opraví ty, které najde."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "První pomoc zkontroluje chyby na svazku a opraví ty, které najde. Svazek je během kontroly odpojený, takže jeho soubory nelze až do dokončení používat."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "První pomoc zkontroluje chyby na svazku a opraví ty, které najde."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Spustit První pomoc na „{name}“?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Spustit"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Nejsou žádné svazky ke kontrole."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Kontrola „{name}“…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "„{name}“ už není k dispozici. Přeskočeno."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "„{name}“ je zamčený. Chcete-li ho zkontrolovat, odemkněte ho. Přeskočeno."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "„{name}“ neobsahuje systém souborů, který by První pomoc mohla zkontrolovat. Přeskočeno."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Kontrola „{name}“ ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "neznámý formát"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 nedokázal zjistit, zda lze svazky {format} zkontrolovat. Zkuste to později."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Svazky {format} nelze zkontrolovat: {tool} není nainstalován."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Odpojování „{name}“."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "„{name}“ se používá a nelze ho odpojit. Zavřete soubory a ukončete programy, které ho používají, a potom spusťte První pomoc znovu."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "„{name}“ používá {programs} a nelze ho odpojit. Zavřete jejich soubory na něm nebo je ukončete a potom spusťte První pomoc znovu."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "„{name}“ nelze odpojit: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Kontrola systému souborů."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Kontrola selhala: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Systém souborů se zdá být v pořádku."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "Systém souborů obsahuje chyby."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 nedokázal zjistit, zda lze svazky {format} opravit."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Svazky {format} nelze opravit: {tool} není nainstalován."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Oprava systému souborů."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Oprava „{name}“…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Systém souborů byl opraven."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Systém souborů nelze opravit."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Oprava selhala: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Opětovné připojování „{name}“."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "„{name}“ nelze znovu připojit: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "První pomoc byla zrušena."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "První pomoc našla chyby, které nedokázala opravit. Zálohujte data, která můžete, a svazek vymažte."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Proces První pomoci selhal."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Proces První pomoci byl dokončen."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} svazek byl přeskočen."
msgstr[1] "{n} svazky byly přeskočeny."
msgstr[2] "{n} svazků bylo přeskočeno."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "První pomoc"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Byl odebrán nebo nahrazen jiným diskem, takže se s ním už nic dalšího neprovede."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Podrobnosti S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " a "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "„{name}“ nelze připojit."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "„{name}“ nelze odpojit."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "„{name}“ nelze zamknout."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "„{name}“ nelze vysunout."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Některý program stále používá soubor na něm. Zavřete soubory a ukončete programy, které ho používají, a zkuste to znovu."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Používá ho {programs}. Zavřete jejich soubory na něm nebo je ukončete a zkuste to znovu."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Na tomto disku stále probíhá jiná operace."


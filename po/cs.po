msgstr "Nový prázdný obraz"

#: src/dialogs/newimage.cpp
msgid "Save As"
msgstr "Uložit jako"

#: src/dialogs/newimage.cpp
msgid "Where"
msgstr "Umístění"

#: src/dialogs/newimage.cpp
msgid "Choose…"
msgstr "Vybrat…"

#: src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Size"
msgstr "Velikost"

#: src/dialogs/newimage.cpp src/udisks/properties.cpp
msgid "None"
msgstr "Žádné"

#: src/dialogs/newimage.cpp src/udisks/properties.cpp
msgid "Encryption"
msgstr "Šifrování"

#: src/dialogs/newimage.cpp
msgid "Encrypted with a Password"
msgstr "Šifrováno heslem"

#: src/dialogs/newimage.cpp
msgid "Password"
msgstr "Heslo"

#: src/dialogs/newimage.cpp
msgid "Create"
msgstr "Vytvořit"

#: src/dialogs/newimage.cpp
msgid "Type a name for the image file."
msgstr "Zadejte název souboru obrazu."

#: src/dialogs/newimage.cpp
msgid "The folder is no longer there."
msgstr "Složka už neexistuje."

#: src/dialogs/newimage.cpp
#, python-brace-format
msgid "A file named “{name}” already exists in this folder."
msgstr "Soubor s názvem „{name}“ už v této složce existuje."

#: src/dialogs/newimage.cpp
msgid "Type a size, such as 100 MB."
msgstr "Zadejte velikost, například 100 MB."


msgstr "„{name}“ nelze otevřít."

#: src/dialogs/diskimages.cpp src/dialogs/newimage.cpp
#: src/dialogs/volume_format.cpp
msgid "Untitled"
msgstr "Bez názvu"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Obraz nelze vytvořit."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Soubor je připojený obraz disku. Nejprve ho vysuňte."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Obraz nelze uložit přímo na „{name}“. Vyberte složku na jiném disku."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "Na „{name}“ je běžící systém, a proto ho nelze odpojit a přečíst."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Vytváření „{name}“"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Kopírování „{source}“ do „{file}“."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "„{file}“ byl vytvořen."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "Chcete-li vytvořit obraz „{name}“, je nutné ho odpojit."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Před čtením se odpojí, a je-li šifrovaný, i zamkne, a takto zůstane i potom."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Probíhá jiné kopírování."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Počkejte na jeho dokončení, nebo ho nejprve zastavte."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Vymazat „{name}“"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Vymazáním „{name}“ se smažou všechny svazky na něm a vše, co je na nich uloženo. Tuto akci nelze vrátit. Vyberte název, formát a schéma oddílů."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Vymazáním „{name}“ se smaže vše, co je na něm uloženo. Tuto akci nelze vrátit. Vyberte název a formát."

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/rename.cpp src/dialogs/volume_actions.cpp

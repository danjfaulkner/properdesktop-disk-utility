#: src/actions.cpp src/views/diskwindow.cpp
msgid "View"
msgstr "보기"

#: src/actions.cpp
msgid "Add Partition…"
msgstr "파티션 추가…"

#: src/actions.cpp
msgid "Delete Partition…"
msgstr "파티션 삭제…"

#: src/actions.cpp
msgid "First Aid…"
msgstr "응급 처치…"

#: src/actions.cpp
msgid "Partition…"
msgstr "파티션…"

#: src/actions.cpp
msgid "Erase…"
msgstr "지우기…"

#: src/actions.cpp
msgid "Restore…"
msgstr "복원…"

#: src/actions.cpp
msgid "Mount"
msgstr "마운트"

#: src/actions.cpp src/dialogs/diskimages.cpp
msgid "Unmount"
msgstr "마운트 해제"

#: src/actions.cpp
msgid "Get Info"
msgstr "정보 가져오기"

#: src/actions.cpp
msgid "Eject"
msgstr "추출"

#: src/actions.cpp
msgid "Rename…"
msgstr "이름 변경…"

#: src/actions.cpp
msgid "Lock"
msgstr "잠그기"

#: src/actions.cpp
msgid "Open Disk Image…"
msgstr "디스크 이미지 열기…"

#: src/actions.cpp
msgid "Blank Image…"
msgstr "빈 이미지…"

#: src/actions.cpp
msgid "Image from Selection…"
msgstr "선택 항목에서 이미지 생성…"

#: src/actions.cpp
msgid "An operation on this disk is in progress."
msgstr "이 디스크에서 작업이 진행 중입니다."

#: src/actions.cpp
msgid "Nothing is restored onto the system's disk: the copy would bring another volume's identity, and the computer could start from the wrong one."
msgstr "시스템 디스크에는 아무것도 복원하지 않습니다. 사본이 다른 볼륨의 식별 정보를 가져와 컴퓨터가 잘못된 볼륨에서 시동할 수 있습니다."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "A Master Boot Record holds at most four partitions."
msgstr "마스터 부트 레코드에는 파티션을 최대 4개까지만 만들 수 있습니다."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "There is no free space for another partition."
msgstr "다른 파티션을 만들 여유 공간이 없습니다."

#: src/actions.cpp
msgid "A partition in it is mounted or unlocked."
msgstr "그 안의 파티션이 마운트되어 있거나 잠금 해제되어 있습니다."

#: src/dialogs/choice_button.cpp
#, python-brace-format
msgid "{choice} ({reason})"
msgstr "{choice}({reason})"

#: src/dialogs/copyprogress.cpp
msgid "Preparing…"
msgstr "준비 중…"

#: src/dialogs/copyprogress.cpp src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Stop"
msgstr "정지"

#: src/dialogs/copyprogress.cpp
msgid "Stopping…"
msgstr "정지하는 중…"

#: src/dialogs/copyprogress.cpp
msgid "Unmounting…"
msgstr "마운트 해제하는 중…"

#: src/dialogs/copyprogress.cpp
msgid "Opening…"
msgstr "여는 중…"

#: src/dialogs/copyprogress.cpp
msgid "Stopped. The incomplete image file was removed."
msgstr "중지되었습니다. 불완전한 이미지 파일이 제거되었습니다."

#: src/dialogs/copyprogress.cpp
msgid "Stopped."
msgstr "정지되었습니다."

#: src/dialogs/copyprogress.cpp
msgid "The destination was overwritten in part. Restore or erase it again before you use it."
msgstr "대상이 일부 덮어쓰였습니다. 사용하기 전에 다시 복원하거나 지우십시오."

#: src/dialogs/copyprogress.cpp
msgid "The incomplete image file was removed."
msgstr "불완전한 이미지 파일이 제거되었습니다."

#: src/dialogs/diskimages.cpp
msgid "The new image could not be mounted."
msgstr "새 이미지를 마운트할 수 없습니다."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Restoring “{name}”"
msgstr "“{name}” 복원 중"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” onto “{target}”."
msgstr "“{source}”을(를) “{target}”에 복사하는 중입니다."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” was restored."
msgstr "“{name}”이(가) 복원되었습니다."

#: src/dialogs/diskimages.cpp
msgid "A copy is in progress."
msgstr "복사가 진행 중입니다."

#: src/dialogs/diskimages.cpp src/views/sidebar.cpp
msgid "Disk Images"
msgstr "디스크 이미지"

#: src/dialogs/diskimages.cpp
msgid "All Files"
msgstr "모든 파일"

#: src/dialogs/diskimages.cpp
msgid "Open Disk Image"
msgstr "디스크 이미지 열기"

#: src/dialogs/diskimages.cpp
msgid "Open"
msgstr "열기"

#: src/dialogs/diskimages.cpp
msgid "Open read-only"
msgstr "읽기 전용으로 열기"

#: src/dialogs/diskimages.cpp
msgid "Restore from Disk Image"
msgstr "디스크 이미지에서 복원"

#: src/dialogs/diskimages.cpp
msgid "Choose"
msgstr "선택"

#: src/dialogs/diskimages.cpp
msgid "Save Image As"
msgstr "다른 이름으로 이미지 저장"

#: src/dialogs/diskimages.cpp
msgid "Save"
msgstr "저장"

#: src/dialogs/diskimages.cpp
msgid "Choose a Folder"
msgstr "폴더 선택"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” could not be opened."
msgstr "“{name}”을(를) 열 수 없습니다."

#: src/dialogs/diskimages.cpp src/dialogs/newimage.cpp
#: src/dialogs/volume_format.cpp
msgid "Untitled"
msgstr "제목 없음"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "이미지를 만들 수 없습니다."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "이 파일은 연결된 디스크 이미지입니다. 먼저 추출하십시오."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "이미지를 “{name}” 자체에 저장할 수 없습니다. 다른 디스크의 폴더를 선택하십시오."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}”에 실행 중인 시스템이 있어 읽기 위해 마운트 해제할 수 없습니다."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "“{name}” 생성 중"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "“{source}”을(를) “{file}”(으)로 복사하는 중입니다."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "“{file}”이(가) 생성되었습니다."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "“{name}”의 이미지를 만들려면 마운트를 해제해야 합니다."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "읽기 전에 마운트가 해제되고, 암호화되어 있으면 잠기며, 이후에도 그 상태로 유지됩니다."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "다른 복사가 진행 중입니다."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "끝날 때까지 기다리거나 먼저 정지하십시오."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "“{name}” 지우기"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "“{name}”을(를) 지우면 그 안의 모든 볼륨과 볼륨에 저장된 모든 내용이 삭제됩니다. 이 작업은 되돌릴 수 없습니다. 이름, 포맷 및 파티션 방식을 선택하십시오."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "“{name}”을(를) 지우면 저장된 모든 내용이 삭제됩니다. 이 작업은 되돌릴 수 없습니다. 이름과 포맷을 선택하십시오."

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/rename.cpp src/dialogs/volume_actions.cpp
#: src/udisks/properties.cpp
msgid "Name"
msgstr "이름"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Format"
msgstr "포맷"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Scheme"
msgstr "방식"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "암호화"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "암호문"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "필수"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "확인"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "볼륨은 암호문으로 잠금 해제한 후에만 읽을 수 있습니다. 암호문을 잊어버리면 데이터를 복구할 수 없습니다."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "보안 옵션…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "지우기"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "최소 {size} 필요"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "{format}을(를) 선택할 수 없음: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "암호문이 일치하지 않습니다."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "마스터 부트 레코드는 “{name}”의 처음 {reach}까지만 사용할 수 있으며, 나머지 {rest}은(는) 사용되지 않습니다. 전체를 사용하려면 GUID 파티션 맵을 선택하십시오."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "먼저 데이터를 0으로 덮어쓰며, 볼륨 전체를 한 번 쓰는 만큼의 시간이 걸립니다."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "빠른 지우기"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "데이터를 0으로 덮어쓰기"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "완료"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "{count}단계 중 {step}단계"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "“{step}” 정지하는 중…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "“{name}”이(가) 지워졌습니다."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}”이(가) 일부만 지워져 지금은 사용할 수 있는 볼륨이 없습니다. 사용하려면 다시 지우십시오."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}”이(가) 지워지지 않았으며, 저장된 내용은 변경되지 않았습니다."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}”이(가) 끝나기 전에 정지되었습니다."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}”이(가) 취소되었습니다."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}”에 실패했습니다."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}”에 실패했습니다: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "세부사항 숨기기"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "세부사항 보기"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "{format} 볼륨을 검사하려면 {tool}이(가) 필요하지만 설치되어 있지 않습니다."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}”이(가) 더 이상 없습니다."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "응급 처치는 디스크의 모든 볼륨에서 오류를 검사하고 발견된 오류를 복구합니다. 마운트된 볼륨은 검사하는 동안 마운트가 해제되었다가 이후 다시 마운트됩니다."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "응급 처치는 디스크의 모든 볼륨에서 오류를 검사하고 발견된 오류를 복구합니다."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "응급 처치는 볼륨의 오류를 검사하고 발견된 오류를 복구합니다. 검사하는 동안 볼륨의 마운트가 해제되므로 완료될 때까지 파일을 사용할 수 없습니다."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "응급 처치는 볼륨의 오류를 검사하고 발견된 오류를 복구합니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "“{name}”에서 응급 처치를 실행하시겠습니까?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "실행"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "검사할 볼륨이 없습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "“{name}” 검사 중…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}”이(가) 더 이상 없습니다. 건너뛰었습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}”이(가) 잠겨 있습니다. 검사하려면 잠금을 해제하십시오. 건너뛰었습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}”에 응급 처치가 검사할 수 있는 파일 시스템이 없습니다. 건너뛰었습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "“{name}”({device}, {format})을(를) 검사하는 중입니다."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "알 수 없는 포맷"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2가 {format} 볼륨을 검사할 수 있는지 확인하지 못했습니다. 나중에 다시 시도하십시오."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "{format} 볼륨을 검사할 수 없습니다: {tool}이(가) 설치되어 있지 않습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "“{name}”을(를) 마운트 해제하는 중입니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}”이(가) 사용 중이어서 마운트를 해제할 수 없습니다. 파일을 닫고 사용 중인 프로그램을 종료한 다음 응급 처치를 다시 실행하십시오."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "{programs}에서 “{name}”을(를) 사용 중이어서 마운트를 해제할 수 없습니다. 해당 프로그램에서 파일을 닫거나 프로그램을 종료한 다음 응급 처치를 다시 실행하십시오."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "“{name}”을(를) 마운트 해제할 수 없습니다: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "파일 시스템을 검사하는 중입니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "검사에 실패했습니다: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "파일 시스템에 문제가 없는 것으로 보입니다."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "파일 시스템에 오류가 있습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2가 {format} 볼륨을 복구할 수 있는지 확인하지 못했습니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "{format} 볼륨을 복구할 수 없습니다: {tool}이(가) 설치되어 있지 않습니다."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "파일 시스템을 복구하는 중입니다."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "“{name}” 복구 중…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "파일 시스템이 복구되었습니다."


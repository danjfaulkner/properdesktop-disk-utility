msgstr "Ảnh trống…"

#: src/actions.cpp
msgid "Image from Selection…"
msgstr "Ảnh từ lựa chọn…"

#: src/actions.cpp
msgid "An operation on this disk is in progress."
msgstr "Một thao tác trên đĩa này đang diễn ra."

#: src/actions.cpp
msgid "Nothing is restored onto the system's disk: the copy would bring another volume's identity, and the computer could start from the wrong one."
msgstr "Không khôi phục gì lên đĩa hệ thống: bản sao sẽ mang định danh của một ổ đĩa khác, và máy tính có thể khởi động từ ổ sai."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "A Master Boot Record holds at most four partitions."
msgstr "Master Boot Record chỉ chứa tối đa bốn phân vùng."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "There is no free space for another partition."
msgstr "Không còn dung lượng trống cho phân vùng khác."

#: src/actions.cpp
msgid "A partition in it is mounted or unlocked."
msgstr "Một phân vùng trong đó đang được gắn hoặc đã mở khóa."

#: src/dialogs/choice_button.cpp
#, python-brace-format
msgid "{choice} ({reason})"
msgstr "{choice} ({reason})"

#: src/dialogs/copyprogress.cpp
msgid "Preparing…"
msgstr "Đang chuẩn bị…"

#: src/dialogs/copyprogress.cpp src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Stop"
msgstr "Dừng"

#: src/dialogs/copyprogress.cpp
msgid "Stopping…"
msgstr "Đang dừng…"

#: src/dialogs/copyprogress.cpp
msgid "Unmounting…"
msgstr "Đang tháo gắn…"

#: src/dialogs/copyprogress.cpp
msgid "Opening…"
msgstr "Đang mở…"

#: src/dialogs/copyprogress.cpp
msgid "Stopped. The incomplete image file was removed."
msgstr "Đã dừng. Tệp ảnh chưa hoàn chỉnh đã bị xoá."

#: src/dialogs/copyprogress.cpp
msgid "Stopped."
msgstr "Đã dừng."

#: src/dialogs/copyprogress.cpp
msgid "The destination was overwritten in part. Restore or erase it again before you use it."
msgstr "Đích đã bị ghi đè một phần. Hãy khôi phục hoặc xoá lại trước khi dùng."

#: src/dialogs/copyprogress.cpp
msgid "The incomplete image file was removed."
msgstr "Tệp ảnh chưa hoàn chỉnh đã bị xoá."

#: src/dialogs/diskimages.cpp
msgid "The new image could not be mounted."
msgstr "Không thể gắn ảnh mới."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Restoring “{name}”"
msgstr "Đang khôi phục “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” onto “{target}”."
msgstr "Đang sao chép “{source}” vào “{target}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” was restored."
msgstr "Đã khôi phục “{name}”."

#: src/dialogs/diskimages.cpp
msgid "A copy is in progress."
msgstr "Đang có một bản sao chép diễn ra."

#: src/dialogs/diskimages.cpp src/views/sidebar.cpp
msgid "Disk Images"
msgstr "Ảnh đĩa"

#: src/dialogs/diskimages.cpp
msgid "All Files"
msgstr "Tất cả tệp"

#: src/dialogs/diskimages.cpp
msgid "Open Disk Image"
msgstr "Mở ảnh đĩa"

#: src/dialogs/diskimages.cpp
msgid "Open"
msgstr "Mở"

#: src/dialogs/diskimages.cpp
msgid "Open read-only"
msgstr "Mở chỉ đọc"

#: src/dialogs/diskimages.cpp
msgid "Restore from Disk Image"
msgstr "Khôi phục từ ảnh đĩa"

#: src/dialogs/diskimages.cpp
msgid "Choose"
msgstr "Chọn"

#: src/dialogs/diskimages.cpp
msgid "Save Image As"
msgstr "Lưu ảnh thành"

#: src/dialogs/diskimages.cpp
msgid "Save"
msgstr "Lưu"

#: src/dialogs/diskimages.cpp
msgid "Choose a Folder"
msgstr "Chọn thư mục"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” could not be opened."
msgstr "Không thể mở “{name}”."

#: src/dialogs/diskimages.cpp src/dialogs/newimage.cpp
#: src/dialogs/volume_format.cpp
msgid "Untitled"
msgstr "Không có tiêu đề"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Không thể tạo ảnh."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Tệp này là một ảnh đĩa đang được gắn. Hãy đẩy nó ra trước."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Không thể lưu ảnh lên chính “{name}”. Hãy chọn một thư mục trên đĩa khác."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” chứa hệ thống đang chạy nên không thể tháo gắn để đọc."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Đang tạo “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Đang sao chép “{source}” vào “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "Đã tạo “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "Phải tháo gắn “{name}” để tạo ảnh của nó."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Nó sẽ được tháo gắn, và khóa lại nếu được mã hóa, trước khi đọc, và giữ nguyên như vậy sau đó."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Đang có một bản sao chép khác diễn ra."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Hãy chờ nó hoàn tất hoặc dừng nó trước."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Xóa “{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Xóa “{name}” sẽ xóa mọi ổ đĩa trên đó và mọi thứ được lưu trên chúng. Không thể hoàn tác thao tác này. Hãy chọn tên, định dạng và lược đồ phân vùng cho nó."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Xóa “{name}” sẽ xóa mọi thứ được lưu trên đó. Không thể hoàn tác thao tác này. Hãy chọn tên và định dạng cho nó."

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/rename.cpp src/dialogs/volume_actions.cpp
#: src/udisks/properties.cpp
msgid "Name"
msgstr "Tên"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Format"
msgstr "Định dạng"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Scheme"
msgstr "Lược đồ"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Mã hóa"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Cụm mật khẩu"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Bắt buộc"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Xác nhận"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Ổ đĩa chỉ có thể được đọc sau khi mở khóa bằng cụm mật khẩu. Nếu bạn quên cụm mật khẩu, dữ liệu sẽ không thể khôi phục."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Tùy chọn bảo mật…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Xóa"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "cần ít nhất {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "Không thể chọn {format}: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Các cụm mật khẩu không khớp."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Master Boot Record chỉ dùng được {reach} đầu tiên của “{name}”; {rest} còn lại sẽ không được dùng. Hãy chọn Bản đồ phân vùng GUID để dùng toàn bộ."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Dữ liệu sẽ được ghi đè bằng số không trước, mất thời gian bằng việc ghi toàn bộ ổ đĩa một lần."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Xóa nhanh"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Ghi đè số không"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Xong"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Bước {step}/{count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Đang dừng “{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "Đã xóa “{name}”."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}” chỉ được xóa một phần và hiện không có ổ đĩa nào dùng được. Hãy xóa lại để sử dụng."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}” chưa được xóa; không có gì được lưu trên đó bị thay đổi."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” đã bị dừng trước khi hoàn tất."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}” đã bị hủy."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}” không thành công."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}” không thành công: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Ẩn chi tiết"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Hiện chi tiết"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Để kiểm tra ổ đĩa {format} cần có {tool}, nhưng công cụ này chưa được cài đặt."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” không còn nữa."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Sơ cứu kiểm tra lỗi trên mọi ổ đĩa của đĩa và sửa các lỗi tìm thấy. Các ổ đĩa đang gắn sẽ được tháo gắn trong khi kiểm tra và gắn lại sau đó."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Sơ cứu kiểm tra lỗi trên mọi ổ đĩa của đĩa và sửa các lỗi tìm thấy."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Sơ cứu kiểm tra lỗi trên ổ đĩa và sửa các lỗi tìm thấy. Ổ đĩa sẽ được tháo gắn trong khi kiểm tra, nên không thể dùng các tệp của nó cho đến khi xong."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Sơ cứu kiểm tra lỗi trên ổ đĩa và sửa các lỗi tìm thấy."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Chạy Sơ cứu trên “{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Chạy"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Không có ổ đĩa nào để kiểm tra."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Đang kiểm tra “{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” không còn nữa. Đã bỏ qua."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” đang bị khóa. Hãy mở khóa để kiểm tra. Đã bỏ qua."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}” không chứa hệ thống tệp nào mà Sơ cứu có thể kiểm tra. Đã bỏ qua."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Đang kiểm tra “{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "định dạng không xác định"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 không xác định được ổ đĩa {format} có thể kiểm tra hay không. Hãy thử lại sau."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Không thể kiểm tra ổ đĩa {format}: chưa cài đặt {tool}."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Đang tháo gắn “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” đang được sử dụng nên không thể tháo gắn. Hãy đóng các tệp và thoát các chương trình đang dùng nó, rồi chạy lại Sơ cứu."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "“{name}” đang được {programs} sử dụng nên không thể tháo gắn. Hãy đóng các tệp của chúng trên đó hoặc thoát chúng, rồi chạy lại Sơ cứu."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "Không thể tháo gắn “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Đang kiểm tra hệ thống tệp."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Kiểm tra không thành công: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Hệ thống tệp có vẻ ổn."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "Hệ thống tệp có lỗi."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 không xác định được ổ đĩa {format} có thể sửa chữa hay không."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Không thể sửa ổ đĩa {format}: chưa cài đặt {tool}."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Đang sửa hệ thống tệp."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Đang sửa “{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Đã sửa hệ thống tệp."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Không thể sửa hệ thống tệp."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Sửa chữa không thành công: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Đang gắn lại “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "Không thể gắn lại “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Sơ cứu đã bị hủy."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Sơ cứu tìm thấy lỗi không thể sửa. Hãy sao lưu những dữ liệu có thể và xóa ổ đĩa."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Quá trình Sơ cứu không thành công."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Quá trình Sơ cứu đã hoàn tất."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "Đã bỏ qua {n} ổ đĩa."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Sơ cứu"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Nó đã bị gỡ ra hoặc thay bằng một đĩa khác, nên không thực hiện gì thêm trên nó."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Chi tiết S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " và "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "Không thể gắn “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "Không thể tháo gắn “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "Không thể khóa “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "Không thể đẩy “{name}” ra."


msgstr "Skema"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Sulitkan"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Frasa laluan"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Diperlukan"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Sahkan"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Volum hanya boleh dibaca selepas dibuka kuncinya dengan frasa laluan. Jika anda terlupa frasa laluan, data tidak dapat dipulihkan."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Pilihan Keselamatan…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Padam"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "memerlukan sekurang-kurangnya {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "{format} tidak boleh dipilih: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Frasa laluan tidak sepadan."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Master Boot Record hanya mencapai {reach} pertama “{name}”; baki {rest} tidak digunakan. Pilih Peta Petak GUID untuk menggunakan kesemuanya."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Data ditulis ganti dengan sifar dahulu, yang mengambil masa selama menulis keseluruhan volum sekali."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Padam Pantas"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Sifarkan Data"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Selesai"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Langkah {step} daripada {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Menghentikan “{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "“{name}” telah dipadam."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}” hanya dipadam sebahagian dan kini tiada volum yang boleh digunakan. Padamkannya semula untuk menggunakannya."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}” tidak dipadam; tiada apa-apa yang disimpan padanya diubah."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” dihentikan sebelum selesai."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}” dibatalkan."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}” gagal."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}” gagal: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Sembunyikan Butiran"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Tunjukkan Butiran"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Menyemak volum {format} memerlukan {tool}, yang tidak dipasang."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” sudah tiada."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Pertolongan Cemas menyemak setiap volum pada cakera untuk ralat dan membaiki ralat yang ditemui. Volum yang dilekapkan dinyahlekap semasa disemak dan dilekapkan semula selepas itu."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Pertolongan Cemas menyemak setiap volum pada cakera untuk ralat dan membaiki ralat yang ditemui."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Pertolongan Cemas menyemak volum untuk ralat dan membaiki ralat yang ditemui. Volum dinyahlekap semasa disemak, jadi failnya tidak boleh digunakan sehingga selesai."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Pertolongan Cemas menyemak volum untuk ralat dan membaiki ralat yang ditemui."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Jalankan Pertolongan Cemas pada “{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Jalankan"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Tiada volum untuk disemak."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Menyemak “{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” sudah tiada. Dilangkau."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” berkunci. Buka kuncinya untuk menyemaknya. Dilangkau."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}” tidak mengandungi sistem fail yang boleh disemak oleh Pertolongan Cemas. Dilangkau."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Menyemak “{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "format tidak diketahui"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 tidak dapat memastikan sama ada volum {format} boleh disemak. Cuba lagi kemudian."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Volum {format} tidak boleh disemak: {tool} tidak dipasang."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Menyahlekap “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” sedang digunakan dan tidak boleh dinyahlekap. Tutup fail dan keluar daripada program yang menggunakannya, kemudian jalankan Pertolongan Cemas semula."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "“{name}” sedang digunakan oleh {programs} dan tidak boleh dinyahlekap. Tutup fail program itu padanya atau keluar daripadanya, kemudian jalankan Pertolongan Cemas semula."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "“{name}” tidak dapat dinyahlekap: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Menyemak sistem fail."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Semakan gagal: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Sistem fail kelihatan baik."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "Sistem fail mempunyai ralat."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 tidak dapat memastikan sama ada volum {format} boleh dibaiki."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Volum {format} tidak boleh dibaiki: {tool} tidak dipasang."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Membaiki sistem fail."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Membaiki “{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Sistem fail telah dibaiki."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Sistem fail tidak dapat dibaiki."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Pembaikan gagal: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Melekapkan semula “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "“{name}” tidak dapat dilekapkan semula: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Pertolongan Cemas dibatalkan."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Pertolongan Cemas menemui ralat yang tidak dapat dibaiki. Sandarkan data yang boleh dan padamkan volum itu."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Proses Pertolongan Cemas telah gagal."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Proses Pertolongan Cemas telah selesai."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} volum dilangkau."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Pertolongan Cemas"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Ia telah ditanggalkan atau diganti dengan cakera lain, jadi tiada apa-apa lagi dilakukan padanya."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Butiran S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " dan "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "“{name}” tidak dapat dilekapkan."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "“{name}” tidak dapat dinyahlekap."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "“{name}” tidak dapat dikunci."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "“{name}” tidak dapat dilentingkan."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Masih ada program yang menggunakan fail padanya. Tutup fail dan keluar daripada program yang menggunakannya, kemudian cuba lagi."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Ia sedang digunakan oleh {programs}. Tutup fail program itu padanya atau keluar daripadanya, kemudian cuba lagi."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Satu lagi operasi pada cakera ini masih berjalan."


msgid "Untitled"
msgstr "Tanpa Tajuk"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Imej tidak dapat dicipta."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Fail ini ialah imej cakera yang sedang dipasangkan. Lentingkannya dahulu."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Imej tidak boleh disimpan pada “{name}” itu sendiri. Pilih folder pada cakera lain."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” mengandungi sistem yang sedang berjalan, jadi ia tidak boleh dinyahlekap untuk dibaca."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Mencipta “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Menyalin “{source}” ke dalam “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "“{file}” telah dicipta."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "“{name}” mesti dinyahlekap untuk membuat imejnya."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Ia dinyahlekap, dan dikunci jika disulitkan, sebelum dibaca, dan kekal begitu selepas itu."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Satu lagi penyalinan sedang berjalan."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Tunggu sehingga ia selesai, atau hentikannya dahulu."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Padam “{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Memadam “{name}” akan memadam setiap volum padanya dan semua yang disimpan padanya. Tindakan ini tidak boleh dibuat asal. Pilih nama, format dan skema petak untuknya."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Memadam “{name}” akan memadam semua yang disimpan padanya. Tindakan ini tidak boleh dibuat asal. Pilih nama dan format untuknya."


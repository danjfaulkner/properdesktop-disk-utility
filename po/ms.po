msgstr "Folder itu sudah tiada."

#: src/dialogs/newimage.cpp
#, python-brace-format
msgid "A file named “{name}” already exists in this folder."
msgstr "Fail bernama “{name}” sudah wujud dalam folder ini."

#: src/dialogs/newimage.cpp
msgid "Type a size, such as 100 MB."
msgstr "Taip saiz, seperti 100 MB."

#: src/dialogs/newimage.cpp
#, python-brace-format

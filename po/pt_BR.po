msgstr "Excluir partição"

#: src/dialogs/partition.cpp
#, python-brace-format
msgid "Partition “{name}”"
msgstr "Particionar “{name}”"

#: src/dialogs/partition.cpp
#, python-brace-format
msgid "“{name}” ({size}) has no partition map. Click + to add partitions; Apply creates a GUID Partition Map for them, erasing what is on the disk."
msgstr "“{name}” ({size}) não tem mapa de partição. Clique em + para adicionar partições; Aplicar cria um Mapa de Partição GUID para elas, apagando o que estiver no disco."


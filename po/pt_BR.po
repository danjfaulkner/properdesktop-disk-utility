msgstr "Sem título"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Não foi possível criar a imagem."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "O arquivo é uma imagem de disco conectada. Ejete-a primeiro."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "A imagem não pode ser salva no próprio “{name}”. Escolha uma pasta em outro disco."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” contém o sistema em execução, por isso não pode ser desmontado para ser lido."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Criando “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Copiando “{source}” para “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "“{file}” foi criado."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "“{name}” precisa ser desmontado para que se crie uma imagem dele."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Ele é desmontado, e bloqueado se for criptografado, antes de ser lido, e permanece assim depois."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Há outra cópia em andamento."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Aguarde o término ou pare-a primeiro."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Apagar “{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Apagar “{name}” exclui todos os volumes nele e tudo o que estiver armazenado neles. Isso não pode ser desfeito. Escolha um nome, um formato e um esquema de partição."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Apagar “{name}” exclui tudo o que estiver armazenado nele. Isso não pode ser desfeito. Escolha um nome e um formato."


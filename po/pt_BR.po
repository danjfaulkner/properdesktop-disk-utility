msgid "Scheme"
msgstr "Esquema"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Criptografar"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Frase secreta"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Obrigatório"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Confirmar"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "O volume só pode ser lido depois de desbloqueado com a frase secreta. Se você esquecer a frase secreta, os dados não poderão ser recuperados."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Opções de segurança…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Apagar"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "requer pelo menos {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "Não é possível escolher {format}: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "As frases secretas não coincidem."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Um Registro Mestre de Inicialização alcança apenas os primeiros {reach} de “{name}”; os outros {rest} ficam sem uso. Escolha Mapa de Partição GUID para usar todo o espaço."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Primeiro os dados são sobrescritos com zeros, o que leva o mesmo tempo que gravar o volume inteiro uma vez."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Apagamento rápido"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Zerar dados"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "OK"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Etapa {step} de {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Parando “{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "“{name}” foi apagado."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}” foi apagado apenas em parte e agora não tem nenhum volume utilizável. Apague-o novamente para usá-lo."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}” não foi apagado; nada armazenado nele foi alterado."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” foi interrompido antes de terminar."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}” foi cancelado."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}” falhou."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}” falhou: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Ocultar detalhes"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Mostrar detalhes"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Verificar volumes {format} requer {tool}, que não está instalado."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” não está mais disponível."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Os Primeiros Socorros verificam se há erros em todos os volumes do disco e reparam os que encontrarem. Os volumes montados são desmontados durante a verificação e montados novamente depois."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Os Primeiros Socorros verificam se há erros em todos os volumes do disco e reparam os que encontrarem."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Os Primeiros Socorros verificam se há erros no volume e reparam os que encontrarem. O volume é desmontado durante a verificação, então seus arquivos não podem ser usados até o término."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Os Primeiros Socorros verificam se há erros no volume e reparam os que encontrarem."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Executar Primeiros Socorros em “{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Executar"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Não há volumes para verificar."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Verificando “{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” não está mais disponível. Ignorado."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” está bloqueado. Desbloqueie-o para verificá-lo. Ignorado."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}” não contém um sistema de arquivos que os Primeiros Socorros possam verificar. Ignorado."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Verificando “{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "formato desconhecido"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "O UDisks2 não conseguiu informar se volumes {format} podem ser verificados. Tente novamente mais tarde."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Não é possível verificar volumes {format}: {tool} não está instalado."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Desmontando “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” está em uso e não pode ser desmontado. Feche os arquivos e encerre os programas que o estão usando e execute os Primeiros Socorros novamente."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "“{name}” está em uso por {programs} e não pode ser desmontado. Feche os arquivos deles nesse volume ou encerre-os e execute os Primeiros Socorros novamente."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "Não foi possível desmontar “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Verificando o sistema de arquivos."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "A verificação falhou: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "O sistema de arquivos parece estar OK."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "O sistema de arquivos tem erros."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "O UDisks2 não conseguiu informar se volumes {format} podem ser reparados."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Não é possível reparar volumes {format}: {tool} não está instalado."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Reparando o sistema de arquivos."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Reparando “{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "O sistema de arquivos foi reparado."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Não foi possível reparar o sistema de arquivos."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "O reparo falhou: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Montando “{name}” novamente."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "Não foi possível montar “{name}” novamente: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Os Primeiros Socorros foram cancelados."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Os Primeiros Socorros encontraram erros que não puderam reparar. Faça backup dos dados que puder e apague o volume."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "O processo de Primeiros Socorros falhou."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "O processo de Primeiros Socorros foi concluído."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} volume foi ignorado."
msgstr[1] "{n} volumes foram ignorados."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Primeiros Socorros"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Ele foi removido ou substituído por outro disco, então nada mais será feito nele."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Detalhes S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " e "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "Não foi possível montar “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "Não foi possível desmontar “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "Não foi possível bloquear “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "Não foi possível ejetar “{name}”."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Um programa ainda está usando um arquivo nele. Feche os arquivos e encerre os programas que o estão usando e tente novamente."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Ele está em uso por {programs}. Feche os arquivos deles nesse volume ou encerre-os e tente novamente."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Outra operação neste disco ainda está em execução."


msgstr "停止"

#: src/dialogs/copyprogress.cpp
msgid "Stopping…"
msgstr "正在停止…"

#: src/dialogs/copyprogress.cpp
msgid "Unmounting…"
msgstr "正在卸載…"

#: src/dialogs/copyprogress.cpp
msgid "Opening…"
msgstr "正在打開…"

#: src/dialogs/copyprogress.cpp
msgid "Stopped. The incomplete image file was removed."
msgstr "已停止。不完整的映像檔已移除。"

#: src/dialogs/copyprogress.cpp
msgid "Stopped."
msgstr "已停止。"

#: src/dialogs/copyprogress.cpp
msgid "The destination was overwritten in part. Restore or erase it again before you use it."
msgstr "目的地已被部分覆寫。使用前請再次還原或清除它。"

#: src/dialogs/copyprogress.cpp
msgid "The incomplete image file was removed."
msgstr "不完整的映像檔已移除。"

#: src/dialogs/diskimages.cpp
msgid "The new image could not be mounted."
msgstr "無法掛載新映像檔。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Restoring “{name}”"
msgstr "正在還原「{name}」"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” onto “{target}”."
msgstr "正在將「{source}」拷貝到「{target}」上。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” was restored."
msgstr "已還原「{name}」。"

#: src/dialogs/diskimages.cpp
msgid "A copy is in progress."
msgstr "正在進行拷貝。"

#: src/dialogs/diskimages.cpp src/views/sidebar.cpp
msgid "Disk Images"
msgstr "磁碟映像檔"

#: src/dialogs/diskimages.cpp
msgid "All Files"
msgstr "所有檔案"

#: src/dialogs/diskimages.cpp
msgid "Open Disk Image"
msgstr "打開磁碟映像檔"

#: src/dialogs/diskimages.cpp
msgid "Open"
msgstr "打開"

#: src/dialogs/diskimages.cpp
msgid "Open read-only"
msgstr "以唯讀方式打開"

#: src/dialogs/diskimages.cpp
msgid "Restore from Disk Image"
msgstr "從磁碟映像檔還原"

#: src/dialogs/diskimages.cpp
msgid "Choose"
msgstr "選擇"

#: src/dialogs/diskimages.cpp
msgid "Save Image As"
msgstr "映像檔儲存為"

#: src/dialogs/diskimages.cpp
msgid "Save"
msgstr "儲存"

#: src/dialogs/diskimages.cpp
msgid "Choose a Folder"
msgstr "選擇資料夾"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” could not be opened."
msgstr "無法打開「{name}」。"

#: src/dialogs/diskimages.cpp src/dialogs/newimage.cpp
#: src/dialogs/volume_format.cpp
msgid "Untitled"
msgstr "未命名"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "無法建立映像檔。"

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "此檔案是已連接的磁碟映像檔。請先將其退出。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "映像檔不能儲存在「{name}」本身。請選擇其他磁碟上的資料夾。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "「{name}」包含執行中的系統，因此無法卸載以進行讀取。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "正在建立「{name}」"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "正在將「{source}」拷貝到「{file}」中。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "已建立「{file}」。"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "必須先卸載「{name}」才能為其建立映像檔。"

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "讀取前會將其卸載（若已加密還會鎖定），完成後保持該狀態。"

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "另一個拷貝正在進行。"

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "請等待其完成，或先將其停止。"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "清除「{name}」"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "清除「{name}」將刪除其上所有卷宗及其中儲存的全部內容。此操作無法還原。請為其選擇名稱、格式和分割區配置。"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "清除「{name}」將刪除其中儲存的全部內容。此操作無法還原。請為其選擇名稱和格式。"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/rename.cpp src/dialogs/volume_actions.cpp
#: src/udisks/properties.cpp
msgid "Name"
msgstr "名稱"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Format"
msgstr "格式"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Scheme"
msgstr "配置"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "加密"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "密碼"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "必填"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "驗證"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "必須使用密碼解鎖後才能讀取此卷宗。如果忘記密碼，資料將無法復原。"

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "安全性選項…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "清除"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "至少需要 {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "無法選擇 {format}：{reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "密碼不相符。"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "主開機記錄只能使用「{name}」的前 {reach}，其餘 {rest} 將無法使用。請選擇「GUID 分割區表」以使用全部空間。"

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "會先以零覆寫資料，所需時間與完整寫入一次卷宗相同。"

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "快速清除"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "以零覆寫資料"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "完成"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "第 {step} 步，共 {count} 步"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "正在停止「{step}」…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "已清除「{name}」。"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "「{name}」僅被部分清除，目前沒有可用的卷宗。請再次清除後再使用。"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "「{name}」未被清除，其中儲存的內容均未更改。"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "「{step}」在完成前已被停止。"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "「{step}」已取消。"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "「{step}」失敗。"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "「{step}」失敗：{message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "隱藏詳細資訊"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "顯示詳細資訊"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "檢查 {format} 卷宗需要 {tool}，但尚未安裝。"

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "「{name}」已不存在。"

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "修理工具會檢查磁碟上的每個卷宗是否有錯誤，並修復找到的錯誤。已掛載的卷宗在檢查期間會被卸載，完成後重新掛載。"

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "修理工具會檢查磁碟上的每個卷宗是否有錯誤，並修復找到的錯誤。"

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "修理工具會檢查卷宗是否有錯誤，並修復找到的錯誤。檢查期間卷宗會被卸載，因此在完成前無法使用其中的檔案。"

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "修理工具會檢查卷宗是否有錯誤，並修復找到的錯誤。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "要對「{name}」執行修理工具嗎？"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "執行"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "沒有可檢查的卷宗。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "正在檢查「{name}」…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "「{name}」已不存在。已略過。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "「{name}」已鎖定。請解鎖後再檢查。已略過。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "「{name}」沒有修理工具可以檢查的檔案系統。已略過。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "正在檢查「{name}」（{device}，{format}）。"

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "未知格式"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 無法判斷 {format} 卷宗能否檢查。請稍後再試。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "無法檢查 {format} 卷宗：尚未安裝 {tool}。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "正在卸載「{name}」。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "「{name}」正在使用中，無法卸載。請關閉正在使用它的檔案並結束相關程式，然後再次執行修理工具。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "「{name}」正被 {programs} 使用，無法卸載。請關閉它們在其上開啟的檔案或結束它們，然後再次執行修理工具。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "無法卸載「{name}」：{message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "正在檢查檔案系統。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "檢查失敗：{message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "檔案系統看起來正常。"

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "檔案系統有錯誤。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 無法判斷 {format} 卷宗能否修復。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "無法修復 {format} 卷宗：尚未安裝 {tool}。"

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "正在修復檔案系統。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "正在修復「{name}」…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "檔案系統已修復。"

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "無法修復檔案系統。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "修復失敗：{message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "正在重新掛載「{name}」。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "無法重新掛載「{name}」：{message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "修理工具已取消。"

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "修理工具發現了無法修復的錯誤。請備份可備份的資料，然後清除該卷宗。"

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "修理工具程序失敗。"

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "修理工具程序已完成。"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "已略過 {n} 個卷宗。"

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "修理工具"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "它已被移除或被其他磁碟取代，因此不會再對其執行任何操作。"

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "S.M.A.R.T. 詳細資訊…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr "和"

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "無法掛載「{name}」。"

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "無法卸載「{name}」。"

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "無法鎖定「{name}」。"

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "無法退出「{name}」。"

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "仍有程式在使用其中的檔案。請關閉這些檔案並結束正在使用它的程式，然後再試一次。"

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "它正被 {programs} 使用。請關閉它們在其上開啟的檔案或結束它們，然後再試一次。"

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "此磁碟上的另一個操作仍在進行。"

#: src/dialogs/newimage.cpp
msgid "New Blank Image"
msgstr "新增空白映像檔"

#: src/dialogs/newimage.cpp
msgid "Save As"
msgstr "儲存為"

#: src/dialogs/newimage.cpp
msgid "Where"
msgstr "位置"

#: src/dialogs/newimage.cpp
msgid "Choose…"
msgstr "選擇…"

#: src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Size"
msgstr "大小"

#: src/dialogs/newimage.cpp src/udisks/properties.cpp
msgid "None"
msgstr "無"

#: src/dialogs/newimage.cpp src/udisks/properties.cpp
msgid "Encryption"
msgstr "加密"

#: src/dialogs/newimage.cpp
msgid "Encrypted with a Password"
msgstr "使用密碼加密"

#: src/dialogs/newimage.cpp
msgid "Password"
msgstr "密碼"

#: src/dialogs/newimage.cpp
msgid "Create"
msgstr "建立"

#: src/dialogs/newimage.cpp
msgid "Type a name for the image file."
msgstr "請輸入映像檔的名稱。"

#: src/dialogs/newimage.cpp
msgid "The folder is no longer there."
msgstr "此資料夾已不存在。"


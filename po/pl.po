msgstr "Otwieranie…"

#: src/dialogs/copyprogress.cpp
msgid "Stopped. The incomplete image file was removed."
msgstr "Zatrzymano. Niekompletny plik obrazu został usunięty."

#: src/dialogs/copyprogress.cpp
msgid "Stopped."
msgstr "Zatrzymano."

#: src/dialogs/copyprogress.cpp
msgid "The destination was overwritten in part. Restore or erase it again before you use it."
msgstr "Miejsce docelowe zostało częściowo nadpisane. Odtwórz je lub wymaż ponownie przed użyciem."

#: src/dialogs/copyprogress.cpp
msgid "The incomplete image file was removed."
msgstr "Niekompletny plik obrazu został usunięty."

#: src/dialogs/diskimages.cpp
msgid "The new image could not be mounted."
msgstr "Nie można podłączyć nowego obrazu."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Restoring “{name}”"
msgstr "Odtwarzanie „{name}”"


msgstr "Wybierz folder"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” could not be opened."
msgstr "Nie można otworzyć „{name}”."

#: src/dialogs/diskimages.cpp src/dialogs/newimage.cpp
#: src/dialogs/volume_format.cpp
msgid "Untitled"
msgstr "Bez nazwy"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Nie można utworzyć obrazu."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Ten plik jest dołączonym obrazem dysku. Najpierw go wysuń."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Obrazu nie można zapisać na samym „{name}”. Wybierz folder na innym dysku."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "Na „{name}” znajduje się działający system, więc nie można go odłączyć, aby go odczytać."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Tworzenie „{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Kopiowanie „{source}” do „{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "Utworzono „{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "Aby utworzyć obraz „{name}”, trzeba go odłączyć."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Przed odczytem jest odłączany, a jeśli jest zaszyfrowany — blokowany, i pozostaje taki po zakończeniu."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Trwa inne kopiowanie."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Poczekaj, aż się zakończy, lub najpierw je zatrzymaj."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Wymaż „{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Wymazanie „{name}” usuwa wszystkie woluminy na nim i wszystko, co jest na nich zapisane. Tej operacji nie można cofnąć. Wybierz nazwę, format i schemat partycji."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Wymazanie „{name}” usuwa wszystko, co jest na nim zapisane. Tej operacji nie można cofnąć. Wybierz nazwę i format."

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/rename.cpp src/dialogs/volume_actions.cpp
#: src/udisks/properties.cpp
msgid "Name"
msgstr "Nazwa"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Format"
msgstr "Format"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Scheme"
msgstr "Schemat"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Zaszyfruj"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Hasło"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Wymagane"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Powtórz"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Wolumin można odczytać dopiero po odblokowaniu go hasłem. Jeśli zapomnisz hasło, danych nie da się odzyskać."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Opcje bezpieczeństwa…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Wymaż"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "wymaga co najmniej {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "Nie można wybrać {format}: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Hasła nie są zgodne."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Główny rekord rozruchowy obejmuje tylko pierwsze {reach} dysku „{name}”; pozostałe {rest} pozostaną nieużywane. Wybierz Mapę partycji GUID, aby wykorzystać całość."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Dane są najpierw nadpisywane zerami, co trwa tyle, co jednokrotny zapis całego woluminu."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Szybkie wymazywanie"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Wyzeruj dane"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Gotowe"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Krok {step} z {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Zatrzymywanie „{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "Wymazano „{name}”."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "„{name}” wymazano tylko częściowo i nie ma teraz użytecznego woluminu. Wymaż go ponownie, aby go używać."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "Nie wymazano „{name}”; nic z zapisanych na nim danych nie zostało zmienione."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "Krok „{step}” zatrzymano przed zakończeniem."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "Krok „{step}” anulowano."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "Krok „{step}” nie powiódł się."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "Krok „{step}” nie powiódł się: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Ukryj szczegóły"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Pokaż szczegóły"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Sprawdzanie woluminów {format} wymaga programu {tool}, który nie jest zainstalowany."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "„{name}” już nie istnieje."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Pierwsza pomoc sprawdza wszystkie woluminy na dysku pod kątem błędów i naprawia znalezione. Podłączone woluminy są odłączane na czas sprawdzania, a potem podłączane ponownie."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Pierwsza pomoc sprawdza wszystkie woluminy na dysku pod kątem błędów i naprawia znalezione."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Pierwsza pomoc sprawdza wolumin pod kątem błędów i naprawia znalezione. Na czas sprawdzania wolumin jest odłączany, więc jego pliki są niedostępne do zakończenia."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Pierwsza pomoc sprawdza wolumin pod kątem błędów i naprawia znalezione."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Uruchomić Pierwszą pomoc dla „{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Uruchom"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Brak woluminów do sprawdzenia."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Sprawdzanie „{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "„{name}” już nie istnieje. Pominięto."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "„{name}” jest zablokowany. Odblokuj go, aby go sprawdzić. Pominięto."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "„{name}” nie zawiera systemu plików, który Pierwsza pomoc może sprawdzić. Pominięto."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Sprawdzanie „{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "nieznany format"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 nie mógł ustalić, czy woluminy {format} można sprawdzić. Spróbuj ponownie później."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Nie można sprawdzić woluminów {format}: program {tool} nie jest zainstalowany."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Odłączanie „{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "„{name}” jest w użyciu i nie można go odłączyć. Zamknij pliki i zakończ programy, które go używają, a następnie ponownie uruchom Pierwszą pomoc."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "„{name}” jest używany przez {programs} i nie można go odłączyć. Zamknij ich pliki na nim lub zakończ je, a następnie ponownie uruchom Pierwszą pomoc."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "Nie można odłączyć „{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Sprawdzanie systemu plików."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Sprawdzanie nie powiodło się: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "System plików wydaje się sprawny."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "System plików zawiera błędy."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 nie mógł ustalić, czy woluminy {format} można naprawić."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Nie można naprawić woluminów {format}: program {tool} nie jest zainstalowany."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Naprawianie systemu plików."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Naprawianie „{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "System plików został naprawiony."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Nie można naprawić systemu plików."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Naprawa nie powiodła się: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Ponowne podłączanie „{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "Nie można ponownie podłączyć „{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Pierwsza pomoc została anulowana."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Pierwsza pomoc znalazła błędy, których nie mogła naprawić. Utwórz kopię zapasową danych, które się da, i wymaż wolumin."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Proces Pierwszej pomocy nie powiódł się."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Proces Pierwszej pomocy został zakończony."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "Pominięto {n} wolumin."
msgstr[1] "Pominięto {n} woluminy."
msgstr[2] "Pominięto {n} woluminów."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Pierwsza pomoc"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Został odłączony lub zastąpiony innym dyskiem, więc nic więcej nie zostanie z nim zrobione."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Szczegóły S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " i "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "Nie można podłączyć „{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "Nie można odłączyć „{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "Nie można zablokować „{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "Nie można wysunąć „{name}”."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Program nadal używa pliku na nim. Zamknij pliki i zakończ programy, które go używają, a następnie spróbuj ponownie."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Jest używany przez {programs}. Zamknij ich pliki na nim lub zakończ je, a następnie spróbuj ponownie."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Na tym dysku nadal trwa inna operacja."

#: src/dialogs/newimage.cpp
msgid "New Blank Image"
msgstr "Nowy pusty obraz"

#: src/dialogs/newimage.cpp
msgid "Save As"
msgstr "Zapisz jako"

#: src/dialogs/newimage.cpp
msgid "Where"
msgstr "Miejsce"

#: src/dialogs/newimage.cpp
msgid "Choose…"
msgstr "Wybierz…"

#: src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Size"
msgstr "Rozmiar"

#: src/dialogs/newimage.cpp src/udisks/properties.cpp
msgid "None"
msgstr "Brak"

#: src/dialogs/newimage.cpp src/udisks/properties.cpp
msgid "Encryption"
msgstr "Szyfrowanie"

#: src/dialogs/newimage.cpp
msgid "Encrypted with a Password"
msgstr "Szyfrowanie hasłem"

#: src/dialogs/newimage.cpp
msgid "Password"
msgstr "Hasło"

#: src/dialogs/newimage.cpp
msgid "Create"
msgstr "Utwórz"

#: src/dialogs/newimage.cpp
msgid "Type a name for the image file."
msgstr "Wpisz nazwę pliku obrazu."

#: src/dialogs/newimage.cpp
msgid "The folder is no longer there."
msgstr "Folder już nie istnieje."

#: src/dialogs/newimage.cpp
#, python-brace-format

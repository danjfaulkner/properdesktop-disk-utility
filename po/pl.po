#, python-brace-format
msgid "“{name}” was restored."
msgstr "Odtworzono „{name}”."

#: src/dialogs/diskimages.cpp
msgid "A copy is in progress."
msgstr "Trwa kopiowanie."

#: src/dialogs/diskimages.cpp src/views/sidebar.cpp
msgid "Disk Images"
msgstr "Obrazy dysków"

#: src/dialogs/diskimages.cpp
msgid "All Files"
msgstr "Wszystkie pliki"

#: src/dialogs/diskimages.cpp
msgid "Open Disk Image"
msgstr "Otwórz obraz dysku"

#: src/dialogs/diskimages.cpp
msgid "Open"
msgstr "Otwórz"


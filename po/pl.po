msgstr "Na tym dysku trwa operacja."

#: src/actions.cpp
msgid "Nothing is restored onto the system's disk: the copy would bring another volume's identity, and the computer could start from the wrong one."
msgstr "Na dysk systemowy nic nie jest odtwarzane: kopia przeniosłaby tożsamość innego woluminu i komputer mógłby uruchomić się z niewłaściwego."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "A Master Boot Record holds at most four partitions."
msgstr "Główny rekord rozruchowy mieści najwyżej cztery partycje."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "There is no free space for another partition."
msgstr "Brak wolnego miejsca na kolejną partycję."

#: src/actions.cpp
msgid "A partition in it is mounted or unlocked."
msgstr "Jedna z jego partycji jest podłączona lub odblokowana."


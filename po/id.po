msgstr "Tanpa Judul"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Image tidak dapat dibuat."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "File ini adalah image disk yang sedang terpasang. Keluarkan terlebih dahulu."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Image tidak dapat disimpan di “{name}” itu sendiri. Pilih folder di disk lain."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” berisi sistem yang sedang berjalan, sehingga tidak dapat dilepas untuk dibaca."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Membuat “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Menyalin “{source}” ke “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "“{file}” telah dibuat."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "“{name}” harus dilepas untuk membuat image-nya."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Volume dilepas, dan dikunci jika terenkripsi, sebelum dibaca, dan tetap demikian setelahnya."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Penyalinan lain sedang berlangsung."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Tunggu hingga selesai, atau hentikan terlebih dahulu."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Hapus “{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Menghapus “{name}” akan menghapus setiap volume di dalamnya beserta semua yang tersimpan. Tindakan ini tidak dapat dibatalkan. Pilih nama, format, dan skema partisi untuknya."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Menghapus “{name}” akan menghapus semua yang tersimpan di dalamnya. Tindakan ini tidak dapat dibatalkan. Pilih nama dan format untuknya."


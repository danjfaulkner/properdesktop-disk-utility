msgstr "Skema"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Enkripsi"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Frasa sandi"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Wajib"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Verifikasi"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Volume hanya dapat dibaca setelah dibuka dengan frasa sandi. Jika Anda lupa frasa sandinya, data tidak dapat dipulihkan."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Opsi Keamanan…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Hapus"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "memerlukan minimal {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "{format} tidak dapat dipilih: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Frasa sandi tidak cocok."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Master Boot Record hanya menjangkau {reach} pertama dari “{name}”; sisa {rest} tidak terpakai. Pilih Peta Partisi GUID untuk menggunakan seluruhnya."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Data ditimpa dengan nol terlebih dahulu, yang memakan waktu selama menulis seluruh volume satu kali."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Hapus Cepat"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Timpa Data dengan Nol"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Selesai"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Langkah {step} dari {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Menghentikan “{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "“{name}” telah dihapus."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}” hanya terhapus sebagian dan kini tidak memiliki volume yang dapat digunakan. Hapus lagi untuk menggunakannya."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}” tidak dihapus; tidak ada yang tersimpan di dalamnya yang diubah."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” dihentikan sebelum selesai."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}” dibatalkan."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}” gagal."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}” gagal: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Sembunyikan Detail"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Tampilkan Detail"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Memeriksa volume {format} memerlukan {tool}, yang tidak terpasang."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” sudah tidak ada."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Pertolongan Pertama memeriksa setiap volume di disk dari kesalahan dan memperbaiki yang ditemukan. Volume yang terpasang dilepas selama diperiksa dan dipasang kembali setelahnya."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Pertolongan Pertama memeriksa setiap volume di disk dari kesalahan dan memperbaiki yang ditemukan."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Pertolongan Pertama memeriksa volume dari kesalahan dan memperbaiki yang ditemukan. Volume dilepas selama diperiksa, sehingga file-nya tidak dapat digunakan sampai selesai."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Pertolongan Pertama memeriksa volume dari kesalahan dan memperbaiki yang ditemukan."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Jalankan Pertolongan Pertama pada “{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Jalankan"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Tidak ada volume untuk diperiksa."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Memeriksa “{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” sudah tidak ada. Dilewati."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” terkunci. Buka kuncinya untuk memeriksanya. Dilewati."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}” tidak berisi sistem file yang dapat diperiksa Pertolongan Pertama. Dilewati."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Memeriksa “{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "format tidak dikenal"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 tidak dapat memastikan apakah volume {format} dapat diperiksa. Coba lagi nanti."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Volume {format} tidak dapat diperiksa: {tool} tidak terpasang."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Melepas “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” sedang digunakan dan tidak dapat dilepas. Tutup file dan keluar dari program yang menggunakannya, lalu jalankan Pertolongan Pertama lagi."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "“{name}” sedang digunakan oleh {programs} dan tidak dapat dilepas. Tutup file mereka di dalamnya atau keluar dari program tersebut, lalu jalankan Pertolongan Pertama lagi."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "“{name}” tidak dapat dilepas: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Memeriksa sistem file."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Pemeriksaan gagal: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Sistem file tampaknya baik-baik saja."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "Sistem file memiliki kesalahan."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 tidak dapat memastikan apakah volume {format} dapat diperbaiki."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Volume {format} tidak dapat diperbaiki: {tool} tidak terpasang."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Memperbaiki sistem file."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Memperbaiki “{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Sistem file telah diperbaiki."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Sistem file tidak dapat diperbaiki."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Perbaikan gagal: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Memasang kembali “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "“{name}” tidak dapat dipasang kembali: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Pertolongan Pertama dibatalkan."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Pertolongan Pertama menemukan kesalahan yang tidak dapat diperbaiki. Cadangkan data yang bisa dan hapus volume tersebut."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Proses Pertolongan Pertama gagal."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Proses Pertolongan Pertama telah selesai."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} volume dilewati."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Pertolongan Pertama"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Disk telah dicabut atau diganti dengan disk lain, sehingga tidak ada lagi yang dilakukan padanya."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Detail S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " dan "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "“{name}” tidak dapat dipasang."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "“{name}” tidak dapat dilepas."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "“{name}” tidak dapat dikunci."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "“{name}” tidak dapat dikeluarkan."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Masih ada program yang menggunakan file di dalamnya. Tutup file dan keluar dari program yang menggunakannya, lalu coba lagi."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Sedang digunakan oleh {programs}. Tutup file mereka di dalamnya atau keluar dari program tersebut, lalu coba lagi."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Operasi lain pada disk ini masih berjalan."


msgstr "Sin título"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "No se ha podido crear la imagen."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "El archivo es una imagen de disco conectada. Expúlsala primero."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "La imagen no se puede guardar en el propio “{name}”. Elige una carpeta de otro disco."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” contiene el sistema en ejecución, así que no se puede desmontar para leerlo."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Creando “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Copiando “{source}” en “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "Se ha creado “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "Hay que desmontar “{name}” para crear una imagen de él."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Se desmonta, y se bloquea si está cifrado, antes de leerlo, y sigue así después."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Hay otra copia en curso."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Espera a que termine o detenla primero."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Borrar “{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Al borrar “{name}” se eliminan todos sus volúmenes y todo lo que contienen. Esta acción no se puede deshacer. Elige un nombre, un formato y un esquema de particiones."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Al borrar “{name}” se elimina todo lo que contiene. Esta acción no se puede deshacer. Elige un nombre y un formato."


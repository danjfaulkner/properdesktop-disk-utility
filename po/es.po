msgstr "Frase de contraseña"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Obligatorio"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Verificar"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "El volumen solo se puede leer después de desbloquearlo con la frase de contraseña. Si la olvidas, no se podrán recuperar los datos."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Opciones de seguridad…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Borrar"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "necesita al menos {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "No se puede elegir {format}: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Las frases de contraseña no coinciden."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Un registro de arranque maestro solo llega a los primeros {reach} de “{name}”; los {rest} restantes quedan sin usar. Elige Mapa de particiones GUID para usarlo entero."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Primero se sobrescriben los datos con ceros, lo que tarda tanto como escribir el volumen entero una vez."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Borrado rápido"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Rellenar con ceros"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Hecho"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Paso {step} de {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Deteniendo “{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "Se ha borrado “{name}”."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}” solo se ha borrado en parte y ahora no tiene ningún volumen utilizable. Bórralo de nuevo para usarlo."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "No se ha borrado “{name}”; no se ha cambiado nada de lo que contiene."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” se detuvo antes de terminar."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "Se ha cancelado “{step}”."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}” ha fallado."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}” ha fallado: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Ocultar detalles"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Mostrar detalles"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Para comprobar volúmenes {format} se necesita {tool}, que no está instalado."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” ya no está."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Primera ayuda comprueba si hay errores en cada volumen del disco y repara los que encuentra. Los volúmenes montados se desmontan mientras se comprueban y se vuelven a montar después."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Primera ayuda comprueba si hay errores en cada volumen del disco y repara los que encuentra."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Primera ayuda comprueba si hay errores en el volumen y repara los que encuentra. El volumen se desmonta mientras se comprueba, así que sus archivos no se pueden usar hasta que termine."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Primera ayuda comprueba si hay errores en el volumen y repara los que encuentra."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "¿Ejecutar Primera ayuda en “{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Ejecutar"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "No hay volúmenes que comprobar."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Comprobando “{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” ya no está. Omitido."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” está bloqueado. Desbloquéalo para comprobarlo. Omitido."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}” no contiene ningún sistema de archivos que Primera ayuda pueda comprobar. Omitido."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Comprobando “{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "formato desconocido"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 no pudo indicar si los volúmenes {format} se pueden comprobar. Inténtalo de nuevo más tarde."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "No se pueden comprobar volúmenes {format}: {tool} no está instalado."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Desmontando “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” está en uso y no se puede desmontar. Cierra los archivos y sal de los programas que lo usan; después, vuelve a ejecutar Primera ayuda."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "{programs} está usando “{name}” y no se puede desmontar. Cierra sus archivos en él o sal de ellos; después, vuelve a ejecutar Primera ayuda."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "No se ha podido desmontar “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Comprobando el sistema de archivos."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "La comprobación ha fallado: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "El sistema de archivos parece estar bien."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "El sistema de archivos tiene errores."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 no pudo indicar si los volúmenes {format} se pueden reparar."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "No se pueden reparar volúmenes {format}: {tool} no está instalado."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Reparando el sistema de archivos."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Reparando “{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Se ha reparado el sistema de archivos."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "No se ha podido reparar el sistema de archivos."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "La reparación ha fallado: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Volviendo a montar “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "No se ha podido volver a montar “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Se ha cancelado Primera ayuda."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Primera ayuda ha encontrado errores que no ha podido reparar. Haz una copia de seguridad de los datos que puedas y borra el volumen."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "El proceso de Primera ayuda ha fallado."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "El proceso de Primera ayuda ha terminado."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "Se ha omitido {n} volumen."
msgstr[1] "Se han omitido {n} volúmenes."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Primera ayuda"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Se ha retirado o sustituido por otro disco, así que no se hace nada más con él."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Detalles S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " y "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "No se ha podido montar “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "No se ha podido desmontar “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "No se ha podido bloquear “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "No se ha podido expulsar “{name}”."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Un programa sigue usando un archivo que hay en él. Cierra los archivos y sal de los programas que lo usan; después, inténtalo de nuevo."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "{programs} lo está usando. Cierra sus archivos en él o sal de ellos; después, inténtalo de nuevo."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Todavía hay otra operación en curso en este disco."


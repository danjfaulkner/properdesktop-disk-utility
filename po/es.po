msgstr "Eliminar partición"

#: src/dialogs/partition.cpp
#, python-brace-format
msgid "Partition “{name}”"
msgstr "Particionar “{name}”"

#: src/dialogs/partition.cpp
#, python-brace-format
msgid "“{name}” ({size}) has no partition map. Click + to add partitions; Apply creates a GUID Partition Map for them, erasing what is on the disk."
msgstr "“{name}” ({size}) no tiene mapa de particiones. Haz clic en + para añadir particiones; Aplicar crea un mapa de particiones GUID para ellas y borra lo que hay en el disco."


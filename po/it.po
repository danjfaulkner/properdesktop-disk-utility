msgstr "Aggiungi partizione"

#: src/dialogs/partition.cpp
msgid "Delete Partition"
msgstr "Elimina partizione"

#: src/dialogs/partition.cpp
#, python-brace-format
msgid "Partition “{name}”"
msgstr "Partiziona “{name}”"

#: src/dialogs/partition.cpp

msgid "Scheme"
msgstr "Schema"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Codifica"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Passphrase"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Obbligatoria"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Verifica"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Il volume può essere letto solo dopo averlo sbloccato con la passphrase. Se dimentichi la passphrase, i dati non potranno essere recuperati."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Opzioni di sicurezza…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Inizializza"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "richiede almeno {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "Impossibile scegliere {format}: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Le passphrase non corrispondono."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Un Master Boot Record raggiunge solo i primi {reach} di “{name}”; i restanti {rest} rimangono inutilizzati. Scegli Mappa partizione GUID per usarlo tutto."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Prima i dati vengono sovrascritti con zeri, il che richiede tanto tempo quanto scrivere l’intero volume una volta."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Inizializzazione rapida"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Azzera i dati"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Fine"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Passaggio {step} di {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Interruzione di “{step}”…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "“{name}” è stato inizializzato."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "“{name}” è stato inizializzato solo in parte e ora non ha alcun volume utilizzabile. Inizializzalo di nuovo per usarlo."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}” non è stato inizializzato; nulla di ciò che contiene è stato modificato."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” è stato interrotto prima di finire."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}” è stato annullato."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "“{step}” non è riuscito."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "“{step}” non è riuscito: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Nascondi dettagli"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Mostra dettagli"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Per verificare i volumi {format} serve {tool}, che non è installato."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” non è più presente."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "S.O.S. verifica la presenza di errori in ogni volume del disco e ripara quelli che trova. I volumi montati vengono smontati durante la verifica e poi montati di nuovo."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "S.O.S. verifica la presenza di errori in ogni volume del disco e ripara quelli che trova."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "S.O.S. verifica la presenza di errori nel volume e ripara quelli che trova. Il volume viene smontato durante la verifica, quindi i suoi file non possono essere usati finché non ha finito."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "S.O.S. verifica la presenza di errori nel volume e ripara quelli che trova."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Eseguire S.O.S. su “{name}”?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Esegui"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Non ci sono volumi da verificare."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Verifica di “{name}”…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” non è più presente. Saltato."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” è bloccato. Sbloccalo per verificarlo. Saltato."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}” non contiene alcun file system che S.O.S. possa verificare. Saltato."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Verifica di “{name}” ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "formato sconosciuto"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 non ha potuto dire se i volumi {format} possono essere verificati. Riprova più tardi."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Impossibile verificare i volumi {format}: {tool} non è installato."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Smontaggio di “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” è in uso e non può essere smontato. Chiudi i file ed esci dai programmi che lo usano, poi esegui di nuovo S.O.S."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "“{name}” è usato da {programs} e non può essere smontato. Chiudi i loro file su di esso o esci da questi programmi, poi esegui di nuovo S.O.S."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "Impossibile smontare “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Verifica del file system."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "La verifica non è riuscita: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Il file system sembra in ordine."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "Il file system contiene errori."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 non ha potuto dire se i volumi {format} possono essere riparati."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Impossibile riparare i volumi {format}: {tool} non è installato."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Riparazione del file system."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Riparazione di “{name}”…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Il file system è stato riparato."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Impossibile riparare il file system."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "La riparazione non è riuscita: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Nuovo montaggio di “{name}”."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "Impossibile montare di nuovo “{name}”: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "S.O.S. è stato annullato."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "S.O.S. ha trovato errori che non è riuscito a riparare. Esegui un backup dei dati che puoi e inizializza il volume."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Il processo S.O.S. non è riuscito."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Il processo S.O.S. è stato completato."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} volume è stato saltato."
msgstr[1] "{n} volumi sono stati saltati."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "S.O.S."

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "È stato rimosso o sostituito da un altro disco, quindi non verrà fatto altro su di esso."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Dettagli S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " e "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "Impossibile montare “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "Impossibile smontare “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "Impossibile bloccare “{name}”."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "Impossibile espellere “{name}”."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Un programma sta ancora usando un file su di esso. Chiudi i file ed esci dai programmi che lo usano, poi riprova."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "È usato da {programs}. Chiudi i loro file su di esso o esci da questi programmi, poi riprova."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Su questo disco è ancora in corso un’altra operazione."

#: src/dialogs/newimage.cpp
msgid "New Blank Image"
msgstr "Nuova immagine vuota"

#: src/dialogs/newimage.cpp
msgid "Save As"
msgstr "Salva come"

#: src/dialogs/newimage.cpp
msgid "Where"
msgstr "Posizione"

#: src/dialogs/newimage.cpp
msgid "Choose…"
msgstr "Scegli…"


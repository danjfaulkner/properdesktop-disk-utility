msgstr "Crea"

#: src/dialogs/newimage.cpp
msgid "Type a name for the image file."
msgstr "Inserisci un nome per il file immagine."

#: src/dialogs/newimage.cpp
msgid "The folder is no longer there."
msgstr "La cartella non è più presente."

#: src/dialogs/newimage.cpp
#, python-brace-format
msgid "A file named “{name}” already exists in this folder."
msgstr "In questa cartella esiste già un file chiamato “{name}”."

#: src/dialogs/newimage.cpp
msgid "Type a size, such as 100 MB."
msgstr "Inserisci una dimensione, ad esempio 100 MB."

#: src/dialogs/newimage.cpp
#, python-brace-format
msgid "A {format} image needs at least {size}."
msgstr "Un’immagine {format} richiede almeno {size}."

#: src/dialogs/newimage.cpp
msgid "Type a password for the image."
msgstr "Inserisci una password per l’immagine."

#: src/dialogs/newimage.cpp

msgid "Untitled"
msgstr "Senza titolo"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Impossibile creare l’immagine."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Il file è un’immagine disco collegata. Espellila prima."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "L’immagine non può essere salvata su “{name}” stesso. Scegli una cartella su un altro disco."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” contiene il sistema in esecuzione, quindi non può essere smontato per essere letto."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Creazione di “{name}”"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Copia di “{source}” in “{file}”."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "“{file}” è stato creato."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "Per crearne un’immagine, “{name}” deve essere smontato."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Viene smontato, e bloccato se è codificato, prima di essere letto, e resta così dopo."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "È in corso un’altra copia."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Attendi che finisca o interrompila prima."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Inizializza “{name}”"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "Inizializzando “{name}” si eliminano tutti i suoi volumi e tutto ciò che contengono. L’operazione non può essere annullata. Scegli un nome, un formato e uno schema di partizione."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "Inizializzando “{name}” si elimina tutto ciò che contiene. L’operazione non può essere annullata. Scegli un nome e un formato."


msgid "The image could not be created."
msgstr "L'image n'a pas pu être créée."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Le fichier est une image disque connectée. Éjectez-la d'abord."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "L'image ne peut pas être enregistrée sur « {name} » lui-même. Choisissez un dossier sur un autre disque."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "« {name} » contient le système en cours d'exécution ; il ne peut donc pas être démonté pour être lu."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Création de « {name} »"

#: src/dialogs/diskimages.cpp
#, python-brace-format

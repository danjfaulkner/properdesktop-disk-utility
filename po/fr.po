msgstr "Impossible de verrouiller « {name} »."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "Impossible d'éjecter « {name} »."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Un programme utilise encore un fichier qui s'y trouve. Fermez les fichiers et quittez les programmes qui l'utilisent, puis réessayez."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Il est utilisé par {programs}. Fermez leurs fichiers qui s'y trouvent ou quittez-les, puis réessayez."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "Une autre opération est encore en cours sur ce disque."


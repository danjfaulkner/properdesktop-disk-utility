#, python-brace-format
msgid "“{name}” was erased."
msgstr "« {name} » a été effacé."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "« {name} » n'a été effacé qu'en partie et n'a plus de volume utilisable. Effacez-le à nouveau pour l'utiliser."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "« {name} » n'a pas été effacé ; rien de ce qu'il contient n'a été modifié."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "« {step} » a été arrêté avant la fin."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "« {step} » a été annulé."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "« {step} » a échoué."


msgstr "Confirmer"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Le volume ne peut être lu qu'après avoir été déverrouillé avec la phrase secrète. Si vous oubliez la phrase secrète, les données ne pourront pas être récupérées."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Options de sécurité…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Effacer"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "nécessite au moins {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "Impossible de choisir {format} : {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Les phrases secrètes ne correspondent pas."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Un enregistrement de démarrage principal n'atteint que les premiers {reach} de « {name} » ; les {rest} restants ne sont pas utilisés. Choisissez Table de partition GUID pour tout utiliser."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Les données sont d'abord remplacées par des zéros, ce qui prend autant de temps que d'écrire une fois tout le volume."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Effacement rapide"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Remplir de zéros"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Terminé"


msgid "Hide Details"
msgstr "Masquer les détails"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Afficher les détails"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "La vérification des volumes {format} nécessite {tool}, qui n'est pas installé."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "« {name} » n'est plus là."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "S.O.S. vérifie chaque volume du disque et répare les erreurs trouvées. Les volumes montés sont démontés pendant la vérification puis remontés ensuite."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "S.O.S. vérifie chaque volume du disque et répare les erreurs trouvées."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "S.O.S. vérifie le volume et répare les erreurs trouvées. Le volume est démonté pendant la vérification ; ses fichiers ne sont donc pas utilisables avant la fin."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "S.O.S. vérifie le volume et répare les erreurs trouvées."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Exécuter S.O.S. sur « {name} » ?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Exécuter"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Il n'y a aucun volume à vérifier."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Vérification de « {name} »…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "« {name} » n'est plus là. Ignoré."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "« {name} » est verrouillé. Déverrouillez-le pour le vérifier. Ignoré."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "« {name} » ne contient aucun système de fichiers que S.O.S. peut vérifier. Ignoré."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Vérification de « {name} » ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "format inconnu"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 n’a pas pu indiquer si les volumes {format} peuvent être vérifiés. Réessayez plus tard."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Les volumes {format} ne peuvent pas être vérifiés : {tool} n'est pas installé."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Démontage de « {name} »."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "« {name} » est en cours d'utilisation et ne peut pas être démonté. Fermez les fichiers et quittez les programmes qui l'utilisent, puis relancez S.O.S."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "« {name} » est utilisé par {programs} et ne peut pas être démonté. Fermez leurs fichiers qui s'y trouvent ou quittez-les, puis relancez S.O.S."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "« {name} » n'a pas pu être démonté : {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Vérification du système de fichiers."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "La vérification a échoué : {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Le système de fichiers semble en bon état."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "Le système de fichiers contient des erreurs."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 n’a pas pu indiquer si les volumes {format} peuvent être réparés."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Les volumes {format} ne peuvent pas être réparés : {tool} n'est pas installé."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Réparation du système de fichiers."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Réparation de « {name} »…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Le système de fichiers a été réparé."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Le système de fichiers n'a pas pu être réparé."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "La réparation a échoué : {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Remontage de « {name} »."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "« {name} » n'a pas pu être remonté : {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "S.O.S. a été annulé."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "S.O.S. a trouvé des erreurs qu'il n'a pas pu réparer. Sauvegardez les données possibles et effacez le volume."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Le processus S.O.S. a échoué."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Le processus S.O.S. est terminé."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} volume a été ignoré."
msgstr[1] "{n} volumes ont été ignorés."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "S.O.S."

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Il a été retiré ou remplacé par un autre disque ; plus rien ne lui est donc appliqué."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Détails S.M.A.R.T.…"

#: src/dialogs/mount.cpp

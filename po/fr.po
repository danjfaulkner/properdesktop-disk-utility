msgstr "Copie de « {source} » dans « {file} »."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "« {file} » a été créé."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "« {name} » doit être démonté pour en créer une image."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Il est démonté, et verrouillé s'il est chiffré, avant d'être lu, et le reste ensuite."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Une autre copie est en cours."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Attendez qu'elle se termine ou arrêtez-la d'abord."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Effacer « {name} »"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "L'effacement de « {name} » supprime tous ses volumes et tout ce qu'ils contiennent. Cette action est irréversible. Choisissez un nom, un format et un schéma de partition."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "L'effacement de « {name} » supprime tout ce qu'il contient. Cette action est irréversible. Choisissez un nom et un format."


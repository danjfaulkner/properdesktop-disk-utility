#: src/actions.cpp src/views/diskwindow.cpp
msgid "View"
msgstr "Вид"

#: src/actions.cpp
msgid "Add Partition…"
msgstr "Добавить раздел…"

#: src/actions.cpp
msgid "Delete Partition…"
msgstr "Удалить раздел…"

#: src/actions.cpp
msgid "First Aid…"
msgstr "Первая помощь…"

#: src/actions.cpp
msgid "Partition…"
msgstr "Разбить на разделы…"

#: src/actions.cpp
msgid "Erase…"
msgstr "Стереть…"

#: src/actions.cpp
msgid "Restore…"
msgstr "Восстановить…"

#: src/actions.cpp
msgid "Mount"
msgstr "Подключить"

#: src/actions.cpp src/dialogs/diskimages.cpp
msgid "Unmount"
msgstr "Отключить"

#: src/actions.cpp
msgid "Get Info"
msgstr "Свойства"

#: src/actions.cpp
msgid "Eject"
msgstr "Извлечь"

#: src/actions.cpp
msgid "Rename…"
msgstr "Переименовать…"

#: src/actions.cpp
msgid "Lock"
msgstr "Заблокировать"

#: src/actions.cpp
msgid "Open Disk Image…"
msgstr "Открыть образ диска…"

#: src/actions.cpp
msgid "Blank Image…"
msgstr "Пустой образ…"

#: src/actions.cpp
msgid "Image from Selection…"
msgstr "Образ из выбранного…"

#: src/actions.cpp
msgid "An operation on this disk is in progress."
msgstr "С этим диском выполняется операция."

#: src/actions.cpp
msgid "Nothing is restored onto the system's disk: the copy would bring another volume's identity, and the computer could start from the wrong one."
msgstr "На системный диск ничего не восстанавливается: копия принесёт идентификатор другого тома, и компьютер может загрузиться не с того."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "A Master Boot Record holds at most four partitions."
msgstr "Основная загрузочная запись вмещает не более четырёх разделов."

#: src/actions.cpp src/dialogs/partition_plan.cpp
#: src/dialogs/volume_actions.cpp
msgid "There is no free space for another partition."
msgstr "Нет свободного места для ещё одного раздела."

#: src/actions.cpp
msgid "A partition in it is mounted or unlocked."
msgstr "Один из его разделов подключён или разблокирован."

#: src/dialogs/choice_button.cpp
#, python-brace-format
msgid "{choice} ({reason})"
msgstr "{choice} ({reason})"

#: src/dialogs/copyprogress.cpp
msgid "Preparing…"
msgstr "Подготовка…"

#: src/dialogs/copyprogress.cpp src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Stop"
msgstr "Остановить"

#: src/dialogs/copyprogress.cpp
msgid "Stopping…"
msgstr "Остановка…"

#: src/dialogs/copyprogress.cpp
msgid "Unmounting…"
msgstr "Отключение…"

#: src/dialogs/copyprogress.cpp
msgid "Opening…"
msgstr "Открытие…"

#: src/dialogs/copyprogress.cpp
msgid "Stopped. The incomplete image file was removed."
msgstr "Остановлено. Неполный файл образа удалён."

#: src/dialogs/copyprogress.cpp
msgid "Stopped."
msgstr "Остановлено."

#: src/dialogs/copyprogress.cpp
msgid "The destination was overwritten in part. Restore or erase it again before you use it."
msgstr "Место назначения перезаписано частично. Восстановите или сотрите его снова перед использованием."

#: src/dialogs/copyprogress.cpp
msgid "The incomplete image file was removed."
msgstr "Неполный файл образа удалён."

#: src/dialogs/diskimages.cpp
msgid "The new image could not be mounted."
msgstr "Не удалось подключить новый образ."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Restoring “{name}”"
msgstr "Восстановление «{name}»"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” onto “{target}”."
msgstr "Копирование «{source}» на «{target}»."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” was restored."
msgstr "«{name}» восстановлен."

#: src/dialogs/diskimages.cpp
msgid "A copy is in progress."
msgstr "Выполняется копирование."

#: src/dialogs/diskimages.cpp src/views/sidebar.cpp
msgid "Disk Images"
msgstr "Образы дисков"

#: src/dialogs/diskimages.cpp
msgid "All Files"
msgstr "Все файлы"

#: src/dialogs/diskimages.cpp
msgid "Open Disk Image"
msgstr "Открыть образ диска"

#: src/dialogs/diskimages.cpp
msgid "Open"
msgstr "Открыть"

#: src/dialogs/diskimages.cpp
msgid "Open read-only"
msgstr "Открыть только для чтения"

#: src/dialogs/diskimages.cpp
msgid "Restore from Disk Image"
msgstr "Восстановить из образа диска"

#: src/dialogs/diskimages.cpp
msgid "Choose"
msgstr "Выбрать"

#: src/dialogs/diskimages.cpp
msgid "Save Image As"
msgstr "Сохранить образ как"

#: src/dialogs/diskimages.cpp
msgid "Save"
msgstr "Сохранить"

#: src/dialogs/diskimages.cpp
msgid "Choose a Folder"
msgstr "Выберите папку"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” could not be opened."
msgstr "Не удалось открыть «{name}»."

#: src/dialogs/diskimages.cpp src/dialogs/newimage.cpp
#: src/dialogs/volume_format.cpp
msgid "Untitled"
msgstr "Без названия"

#: src/dialogs/diskimages.cpp
msgid "The image could not be created."
msgstr "Не удалось создать образ."

#: src/dialogs/diskimages.cpp
msgid "The file is an attached disk image. Eject it first."
msgstr "Этот файл — подключённый образ диска. Сначала извлеките его."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Образ нельзя сохранить на сам «{name}». Выберите папку на другом диске."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "На «{name}» находится работающая система, поэтому его нельзя отключить для чтения."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "Создание «{name}»"

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Copying “{source}” into “{file}”."
msgstr "Копирование «{source}» в «{file}»."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{file}” was created."
msgstr "«{file}» создан."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” must be unmounted to make an image of it."
msgstr "Чтобы создать образ «{name}», его нужно отключить."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Перед чтением он отключается, а если зашифрован — блокируется, и остаётся таким после завершения."

#: src/dialogs/diskimages.cpp
msgid "Another copy is in progress."
msgstr "Выполняется другое копирование."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Дождитесь его завершения или сначала остановите его."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "Стереть «{name}»"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "При стирании «{name}» удаляются все тома на нём и всё, что на них хранится. Это действие нельзя отменить. Выберите имя, формат и схему разделов."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "При стирании «{name}» удаляется всё, что на нём хранится. Это действие нельзя отменить. Выберите имя и формат."

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/rename.cpp src/dialogs/volume_actions.cpp
#: src/udisks/properties.cpp
msgid "Name"
msgstr "Имя"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Format"
msgstr "Формат"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Scheme"
msgstr "Схема"

#: src/dialogs/erase.cpp
msgid "Encrypt"
msgstr "Зашифровать"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Passphrase"
msgstr "Пароль"

#: src/dialogs/erase.cpp src/dialogs/unlock.cpp
msgid "Required"
msgstr "Обязательно"

#: src/dialogs/erase.cpp src/dialogs/newimage.cpp
msgid "Verify"
msgstr "Повтор"

#: src/dialogs/erase.cpp
msgid "The volume can only be read after unlocking it with the passphrase. If you forget the passphrase, the data can't be recovered."
msgstr "Том можно будет прочитать только после разблокировки паролем. Если вы забудете пароль, данные восстановить не удастся."

#: src/dialogs/erase.cpp
msgid "Security Options…"
msgstr "Параметры безопасности…"

#: src/dialogs/erase.cpp
msgid "Erase"
msgstr "Стереть"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "needs at least {size}"
msgstr "нужно не менее {size}"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "{format} can't be chosen: {reason}"
msgstr "Нельзя выбрать {format}: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Пароли не совпадают."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Основная загрузочная запись охватывает только первые {reach} «{name}»; остальные {rest} останутся неиспользуемыми. Выберите «Схема разделов GUID», чтобы использовать весь объём."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Сначала данные перезаписываются нулями — это занимает столько же времени, сколько однократная запись всего тома."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Быстрое стирание"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Обнулить данные"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
msgid "Done"
msgstr "Готово"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Step {step} of {count}"
msgstr "Шаг {step} из {count}"

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "Stopping “{step}”…"
msgstr "Остановка «{step}»…"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased."
msgstr "«{name}» стёрт."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was erased only in part and has no usable volume now. Erase it again to use it."
msgstr "«{name}» стёрт лишь частично, и на нём нет пригодного тома. Сотрите его ещё раз, чтобы использовать."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "«{name}» не стёрт; ничего из хранящегося на нём не изменено."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "«{step}» остановлен до завершения."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "«{step}» отменён."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed."
msgstr "Сбой «{step}»."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” failed: {message}"
msgstr "Сбой «{step}»: {message}"

#: src/dialogs/firstaid.cpp
msgid "Hide Details"
msgstr "Скрыть подробности"

#: src/dialogs/firstaid.cpp
msgid "Show Details"
msgstr "Показать подробности"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking {format} volumes needs {tool}, which is not installed."
msgstr "Для проверки томов {format} нужен {tool}, но он не установлен."

#: src/dialogs/firstaid.cpp src/dialogs/identity_guard.cpp
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "«{name}» больше нет."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds. Mounted volumes are unmounted while they are checked and mounted again afterwards."
msgstr "Первая помощь проверяет все тома на диске на наличие ошибок и исправляет найденные. Подключённые тома на время проверки отключаются, а затем подключаются снова."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks every volume on the disk for errors and repairs the ones it finds."
msgstr "Первая помощь проверяет все тома на диске на наличие ошибок и исправляет найденные."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds. The volume is unmounted while it is checked, so its files can’t be used until it’s done."
msgstr "Первая помощь проверяет том на наличие ошибок и исправляет найденные. На время проверки том отключается, поэтому его файлы недоступны до её завершения."

#: src/dialogs/firstaid.cpp
msgid "First Aid checks the volume for errors and repairs the ones it finds."
msgstr "Первая помощь проверяет том на наличие ошибок и исправляет найденные."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Run First Aid on “{name}”?"
msgstr "Запустить Первую помощь для «{name}»?"

#: src/dialogs/firstaid.cpp
msgid "Run"
msgstr "Запустить"

#: src/dialogs/firstaid.cpp
msgid "There are no volumes to check."
msgstr "Нет томов для проверки."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}”…"
msgstr "Проверка «{name}»…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "«{name}» больше нет. Пропущено."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "«{name}» заблокирован. Разблокируйте его, чтобы проверить. Пропущено."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "На «{name}» нет файловой системы, которую может проверить Первая помощь. Пропущено."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "Проверка «{name}» ({device}, {format})."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "неизвестный формат"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2 не смог сообщить, можно ли проверять тома {format}. Повторите попытку позже."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "Тома {format} нельзя проверить: {tool} не установлен."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "Отключение «{name}»."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "«{name}» используется, и его нельзя отключить. Закройте файлы и завершите программы, которые его используют, затем снова запустите Первую помощь."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "«{name}» используется программами {programs}, и его нельзя отключить. Закройте их файлы на нём или завершите их, затем снова запустите Первую помощь."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "Не удалось отключить «{name}»: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Проверка файловой системы."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Сбой проверки: {message}"

#: src/dialogs/firstaid.cpp
msgid "The file system appears to be OK."
msgstr "Файловая система, по-видимому, в порядке."

#: src/dialogs/firstaid.cpp
msgid "The file system has errors."
msgstr "В файловой системе есть ошибки."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be repaired."
msgstr "UDisks2 не смог сообщить, можно ли исправлять тома {format}."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "Тома {format} нельзя исправить: {tool} не установлен."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Исправление файловой системы."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "Исправление «{name}»…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Файловая система исправлена."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Не удалось исправить файловую систему."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Сбой исправления: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "Повторное подключение «{name}»."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "Не удалось снова подключить «{name}»: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "Первая помощь отменена."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "Первая помощь обнаружила ошибки, которые не удалось исправить. Сохраните резервную копию доступных данных и сотрите том."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "Сбой процесса Первой помощи."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "Процесс Первой помощи завершён."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} том пропущен."
msgstr[1] "{n} тома пропущено."
msgstr[2] "{n} томов пропущено."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "Первая помощь"

#: src/dialogs/identity_guard.cpp
msgid "It was removed or replaced by another disk, so nothing more is done to it."
msgstr "Он был извлечён или заменён другим диском, поэтому с ним больше ничего не делается."

#: src/dialogs/info.cpp
msgid "S.M.A.R.T. Details…"
msgstr "Сведения S.M.A.R.T.…"

#: src/dialogs/mount.cpp
msgid " and "
msgstr " и "

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be mounted."
msgstr "Не удалось подключить «{name}»."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be unmounted."
msgstr "Не удалось отключить «{name}»."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be locked."
msgstr "Не удалось заблокировать «{name}»."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "“{name}” couldn’t be ejected."
msgstr "Не удалось извлечь «{name}»."

#: src/dialogs/mount.cpp
msgid "A program is still using a file on it. Close the files and quit the programs using it, then try again."
msgstr "Программа всё ещё использует файл на нём. Закройте файлы и завершите программы, которые его используют, затем повторите попытку."

#: src/dialogs/mount.cpp
#, python-brace-format
msgid "It is in use by {programs}. Close their files on it or quit them, then try again."
msgstr "Он используется программами {programs}. Закройте их файлы на нём или завершите их, затем повторите попытку."

#: src/dialogs/mount.cpp
msgid "Another operation on this disk is still running."
msgstr "С этим диском всё ещё выполняется другая операция."

#: src/dialogs/newimage.cpp
msgid "New Blank Image"
msgstr "Новый пустой образ"

#: src/dialogs/newimage.cpp
msgid "Save As"
msgstr "Сохранить как"

#: src/dialogs/newimage.cpp
msgid "Where"
msgstr "Где"

#: src/dialogs/newimage.cpp
msgid "Choose…"
msgstr "Выбрать…"

#: src/dialogs/newimage.cpp src/dialogs/partition.cpp
#: src/dialogs/volume_actions.cpp src/udisks/properties.cpp
msgid "Size"
msgstr "Размер"

